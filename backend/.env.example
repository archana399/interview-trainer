# IBM Cloud IAM API Key
WATSONX_API_KEY=<your-ibm-cloud-api-key>

# watsonx.ai Runtime URL — Dallas (us-south) or Frankfurt (eu-de)
# Dallas:   https://us-south.ml.cloud.ibm.com
# Frankfurt: https://eu-de.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# watsonx.ai Studio project GUID (found in Project Settings → General)
WATSONX_PROJECT_ID=<your-project-guid>

# Model IDs — do not change these unless IBM releases newer verified models
WATSONX_LLM_MODEL_ID=ibm/granite-4-h-small
WATSONX_EMBED_MODEL_ID=ibm/granite-embedding-278m-multilingual
